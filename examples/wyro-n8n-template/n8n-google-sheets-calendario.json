    {
      "parameters": {
        "method": "POST",
        "url": "https://wyroapi.com/v1/posts",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify(Object.assign(\n  {\n    text: $json.texto,\n    platforms: String($json.redes || '').split(',').map(r => r.trim().toLowerCase()).filter(Boolean)\n  },\n  $json.imagen_url ? { media: [{ url: String($json.imagen_url).trim() }] } : {},\n  $json.fecha_hora ? { scheduled_at: String($json.fecha_hora).trim() } : {}\n)) }}",
        "options": {}
      },
      "id": "6a522df4-5051-4c50-ac7f-27edb2bf5947",
